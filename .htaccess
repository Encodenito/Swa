# Defence in depth for XAMPP: when Apache's document root is htdocs, this project folder is
# reachable at /SWA/. Deny everything here (.env, storage, backups, vendor...). public/.htaccess
# re-allows its own folder. The real fix is pointing the web server at public/ (docs/DEPLOYMENT.md).
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
